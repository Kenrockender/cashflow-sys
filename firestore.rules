rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Console: Firebase → Firestore → Rules
//
// Household / shared workspace (future): use a workspace doc, e.g.
// workspaces/{wsId}/members/{uid} and scope reads/writes with
// get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).
// Keep per-user paths until you add that schema and migrate data.

service cloud.firestore {
  match /databases/{database}/documents {

    // All user data lives under users/{userId}/...
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && userId.size() > 0;
    }

    // Optional top-level user profile doc (if you add it later)
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
