{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/styles/:path*", "destination": "/public/styles/:path*" },
    { "source": "/icons/:path*", "destination": "/public/icons/:path*" },
    { "source": "/manifest.json", "destination": "/public/manifest.json" },
    { "source": "/logo.svg", "destination": "/public/logo.svg" },
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/service-worker.js", "destination": "/public/service-worker.js" },
    { "source": "/landing.js", "destination": "/public/landing.js" },
    { "source": "/app", "destination": "/public/index.html" },
    { "source": "/", "destination": "/public/landing.html" }
  ]
}
